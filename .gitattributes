# Keep development-only files out of the add-on zip built by git archive
/.github export-ignore
/.gitattributes export-ignore
/.gitignore export-ignore
/.python-version export-ignore
/dev export-ignore
/docs export-ignore
/tests export-ignore
/pyproject.toml export-ignore
/pytest.ini export-ignore
/uv.lock export-ignore
/README.md export-ignore
